{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "0.1.1",
  "description": "__MSG_description__",
  "default_locale": "zh_CN",
  "icons": {
    "128": "icon/128x128.png"
  },
  "action": {
    "default_title": "__MSG_name__",
    "default_icon": {
      "128": "icon/128x128.png"
    }
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://grok.com/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://www.kimi.com/*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://proxycheck.io/*",
    "https://api64.ipify.org/*"
  ],
  "background": {
    "service_worker": "serviceWorker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/little-chihiro/*.png"],
      "matches": [
        "https://grok.com/*",
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://www.kimi.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://grok.com/*",
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://www.kimi.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*"
      ],
      "js": ["mainWorldBridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://grok.com/*",
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://www.kimi.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
