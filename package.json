{
  "name": "ai-usage-floating-monitor",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "docs:build": "node scripts/build-readme.mjs",
    "site:dev": "node scripts/prepare-site.mjs && vite --config vite.site.config.ts --host 127.0.0.1",
    "site:build": "node scripts/prepare-site.mjs && tsc --project tsconfig.site.json && vite build --config vite.site.config.ts",
    "site:preview": "vite preview --config vite.site.config.ts --host 127.0.0.1",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "happy-dom": "^20.14.5",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
